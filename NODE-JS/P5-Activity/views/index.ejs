<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home page</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>See a Instagram post</h1>
    <h2>
        <%for(post of posts){ %>
            <div class="post">
                <h3 class="user">@<%= post.username%></h3>
                <img src="<%=post.image %>" alt="your post image">
            </div>
            <a href="#" class="btn">like</a> &nbsp;&nbsp;&nbsp;
            <a href="/posts/<%= post.id %>" class="btn" style="background-color:wheat">view</a>
            <a href="http://localhost:8080/posts/<%=post.id%>/edit">Edit</a>

            <form action="/posts/<%= post.id %>?_method=DELETE" method="POST">
                <button class="btn" style="background-color: red;">Delete</button>
            </form>
            <%}%>

    </h2>
    <a href="http://localhost:8080/posts/new">Create a new post</a>

</body>
</html>