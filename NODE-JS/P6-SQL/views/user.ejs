<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Page</title>
    <style>
        table, th, td {
            border: 1px solid green;
            padding: 5px;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>S.NO</th>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Password</th>
            <th>Actions</th>
        </tr>
        <% users.forEach((user, index) => { %>
            <tr>
                <td><%= index + 1 %></td>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.email %></td>
                <td><%= user.password %></td>
                <td>
                    <form method="GET" action="/user/<%= user.id %>/edit">
                        <button>Edit Username</button>
                    </form>
                </td>
            </tr>
        <% }); %>
    </table>
</body>
</html>
